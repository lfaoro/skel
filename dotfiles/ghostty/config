# Catppuccin Mocha to match Alacritty + tmux setup.
# The slug "catppuccin-mocha" (common in the Catppuccin ecosystem and
# matching our tmux/alacritty) resolves to the vendored theme file in
# themes/catppuccin-mocha, so it works regardless of how Ghostty is
# installed (nixpkgs, snap, apt, ...).
theme = catppuccin-mocha
# theme = Dracula

# Make text selection (mouse or otherwise) use a yellow hue to match the
# tmux copy-mode selection below. With background-opacity < 1 this appears
# as a tinted/"transparent" highlight.
selection-background = "#f9e2af"
selection-foreground = "#1e1e2e"

font-family = "Hack Nerd Font Mono"
font-size = 15
font-feature = +ss01
font-feature = +ss05
font-feature = +calt

window-decoration = none

# Remove default padding (2pt) so the terminal content uses the full window
# real estate. Matches the explicit zero padding in Alacritty config.
window-padding-x = 0
window-padding-y = 0

# Start maximized (matches Alacritty's startup_mode = "Maximized").
maximize = true

background-opacity = 0.99
# Note: background-blur (not -radius) for modern Ghostty.
background-blur = 20

cursor-opacity = 1
cursor-style = block
# Match Alacritty's cursor.blinking = "Never". Apps can still override
# via DECSCUSR (CSI q), so tmux/Helix cursor styles keep working.
cursor-style-blink = false

# Match Alacritty's selection.save_to_clipboard = true: put selections on
# the system clipboard (and the selection clipboard) instead of only the
# selection clipboard. Middle-click paste always uses the selection
# clipboard regardless.
copy-on-select = clipboard

# Match Alacritty's Super+C / Super+V copy/paste bindings.
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Hide the mouse while typing (matches Alacritty's commented-out
# mouse.hide_when_typing).
mouse-hide-while-typing = true

# Restore window position/size across restarts.
window-save-state = always

# Replicate Alacritty's special Ctrl+; binding so that Ctrl+; triggers
# tmux's prefix (bound to M-;) the same way Alt+; would. Alacritty does
# `chars = "\u001b;"` for `key = "Semicolon", mods = "Control"`.
# We use Ghostty's `esc:;` action (sends ESC + ";") for the same effect.
# Without this, Ghostty encodes Ctrl+; using Kitty keyboard protocol
# (or sends plain ";"), which doesn't match tmux's legacy prefix sequence.
command = zsh -l -c "tmux new-session -A -s main"

keybind = ctrl+;=esc:;

