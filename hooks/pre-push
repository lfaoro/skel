#!/usr/bin/env bash
# Pre-push: scan new commits for sensitive data before pushing.

set -euo pipefail

HOOK_DIR="$(/usr/bin/dirname "$0")"
source "$HOOK_DIR/_sensitive-scan.sh"

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
exit_code=0

while read -r local_ref local_oid remote_ref remote_oid; do
	if [ "$local_oid" = "$zero" ]; then
		continue
	fi

	if [ "$remote_oid" = "$zero" ]; then
		range="$local_oid"
	else
		range="${remote_oid}..${local_oid}"
	fi

	commits=$(git rev-list "$range" 2>/dev/null || true)
	if [ -z "$commits" ]; then
		continue
	fi

	files=$(git diff --name-only --diff-filter=ACM "$range" 2>/dev/null | sort -u || true)
	if [ -z "$files" ]; then
		continue
	fi

	branch="${local_ref#refs/heads/}"
	printf '\033[1;34m→ scanning %s (new commits) for sensitive data...\033[0m\n' "$branch"

	if scan_committed "$local_oid" "$files"; then
		printf '\033[1;32m✓ nothing sensitive found\033[0m\n'
	else
		exit_code=1
	fi
done

if [ "$exit_code" -ne 0 ]; then
	printf '\n\033[1;31m✗ push blocked — sensitive data detected above\033[0m\n'
fi

exit "$exit_code"
